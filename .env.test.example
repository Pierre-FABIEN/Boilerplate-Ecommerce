# Modèle pour `.env.test`, l'environnement des tests end-to-end.
# Copiez ce fichier vers `.env.test` puis renseignez les identifiants.
#
# Les tests écrivent dans un schéma PostgreSQL dédié (`schema=e2e`) : les données
# de développement du schéma `public` ne sont jamais touchées.
# Les guillemets sont indispensables, sinon `&` coupe la valeur dès qu'un shell
# source ce fichier.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE-pooler.REGION.aws.neon.tech/BASE?sslmode=require&channel_binding=require&schema=e2e"
DIRECT_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE.REGION.aws.neon.tech/BASE?sslmode=require&schema=e2e"

# Doit être identique à la clé de développement pour pouvoir déchiffrer les clés
# TOTP et les codes de récupération lus en base.
ENCRYPTION_KEY=
# Idem, seulement si la base de test contient encore des secrets en
# `encryptionVersion=1` (voir le commentaire dans .env.example) — sinon
# inutile.
# ENCRYPTION_KEY_LEGACY=
PUBLIC_ENV='test'
SECRET_NAME_DATA_COOKIE=test-cookie-name

# Autorise l'appel direct des routes de job cron (`/api/jobs/cart-recovery`,
# `/api/jobs/cleanup`) en e2e, sans QStash configuré.
CRON_SECRET=

# Destinataire de l'export comptable mensuel (`/api/jobs/accounting-export`).
ACCOUNTING_EXPORT_EMAIL=e2e-comptabilite@example.test
DISPUTE_ALERT_EMAIL=e2e-litiges@example.test

# Boîte de réception locale démarrée par la préparation globale : nodemailer
# réussit son envoi, aucun email ne sort, et les tests relisent les messages
# capturés sur SMTP_HTTP_PORT.
# Ne pas pointer SMTP_HOST vers un relais réel (Brevo) : le parcours auth
# (`waitForEmailCode`) lit uniquement ce puits.
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_HTTP_PORT=2526
SMTP_USER=e2e
SMTP_PASS=e2e

# Spec live Brevo (`e2e/live/brevo.spec.ts`) : copies des SMTP_* de `.env`.
# Le serveur Vite e2e ignore ces variables. Sans E2E_LIVE_INBOX, le spec
# s'arrête après l'auth SMTP (`transporter.verify()`).
SMTP_LIVE_HOST=e2e
SMTP_LIVE_PORT=587
SMTP_LIVE_USER=e2e
SMTP_LIVE_PASS=e2e
E2E_LIVE_INBOX=

# Valeurs factices : aucun appel externe. Pour tester Cloudinary,
# Google, Stripe ou Sendcloud jusqu'au bout, copiez les vraies clés depuis `.env`
# (jamais committer `.env.test`). Le mock ne s'active que si la valeur est
# encore `e2e` / `e2e-…` / `sk_test_e2e` / `0`.
# L'URI Google de la suite e2e est le port 2001 (pas le 2000 de `npm run dev`) :
# ajoutez-la dans la console Google Cloud.
VITE_GOOGLE_REDIRECT_URI=http://localhost:2001/auth/login/google/callback
GOOGLE_CLIENT_ID=e2e-google-client-id
GOOGLE_CLIENT_SECRET=e2e-google-client-secret

STRIPE_SECRET_KEY=sk_test_e2e
STRIPE_WEBHOOK_SECRET=whsec_e2e
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_e2e

SENDCLOUD_BASE_URL=https://panel.sendcloud.sc
SENDCLOUD_PUBLIC_KEY=e2e
SENDCLOUD_SECRET_KEY=e2e
SENDCLOUD_INTEGRATION_ID=0
SENDCLOUD_SENDER_ADDRESS_ID=e2e
SENDCLOUD_WEBHOOK_SECRET=e2e-sendcloud-webhook-secret
VITE_SHOP_FROM_COUNTRY=FR
VITE_SHOP_FROM_POSTAL=31000

CLOUDINARY_CLOUD_NAME=e2e
CLOUDINARY_API_KEY=e2e
CLOUDINARY_API_SECRET=e2e
PUBLIC_TINYMCE_API_KEY=e2e
SECRET_ADDRESS_SEARCH_MODE=e2e
