{
	"name": "sveltekit-boilerplate",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"clean:vite": "rimraf node_modules/.vite .vite_cache",
		"dev": "concurrently -n vite,studio,stripe -c cyan,magenta,yellow \"vite dev --port 2000 --strictPort\" \"prisma studio --port 5555 --browser none\" \"bash scripts/stripe-listen.sh\"",
		"dev:vite": "vite dev --port 2000 --strictPort",
		"cacheclean": "npm cache clean --force",
		"sync": "svelte-kit sync",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "npm run lint:prettier && npm run lint:eslint",
		"lint:prettier": "prettier --check .",
		"lint:eslint": "eslint .",
		"prettier:watch": "chokidar \"src/**/*.{js,ts,svelte,scss}\" -c \"npm run prettier:single -- {path}\"",
		"prettier:single": "prettier --write",
		"prettier": "prettier --write \"src/**/*.{js,ts,svelte,scss}\"",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:video": "E2E_VIDEO=1 playwright test --retries=0 && node scripts/collect-videos.mjs",
		"test:e2e:headed": "E2E_VIDEO=1 playwright test --headed --retries=0 && node scripts/collect-videos.mjs",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"jobs:register-cleanup-schedule": "node scripts/register-cleanup-schedule.mjs",
		"jobs:register-cart-recovery-schedule": "node scripts/register-cart-recovery-schedule.mjs",
		"jobs:register-accounting-export-schedule": "node scripts/register-accounting-export-schedule.mjs",
		"jobs:register-review-reminder-schedule": "node scripts/register-review-reminder-schedule.mjs",
		"check:legacy-encryption": "node scripts/check-legacy-encryption.mjs",
		"load:catalog": "k6 run k6/catalog.js",
		"load:login": "k6 run k6/login.js",
		"load:admin": "k6 run k6/admin.js",
		"load:webhook": "k6 run k6/webhook.js",
		"postinstall": "prisma generate && node scripts/copy-tinymce.mjs",
		"tinymce:copy": "node scripts/copy-tinymce.mjs",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:status": "prisma migrate status",
		"db:studio": "prisma studio --port 5555",
		"db:studio:e2e": "node --env-file=.env.test node_modules/prisma/build/index.js studio --port 5556",
		"stripe:listen": "bash scripts/stripe-listen.sh",
		"seed": "node prisma/seed.js",
		"seed:perf": "node prisma/seed-perf.js",
		"seed:perf:clean": "node prisma/seed-perf.js --clean",
		"seed:webhook-fixtures": "node prisma/seed-webhook-fixtures.js",
		"seed:webhook-fixtures:clean": "node prisma/seed-webhook-fixtures.js --clean",
		"reset": "prisma migrate reset --force && node prisma/seed.js"
	},
	"devDependencies": {
		"@internationalized/date": "^3.8.1",
		"@lucide/svelte": "^0.482.0",
		"@playwright/test": "^1.52.0",
		"@sveltejs/kit": "^2.21.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.1.7",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/table-core": "^8.21.3",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.0.7",
		"autoprefixer": "^10.4.21",
		"bits-ui": "^2.8.11",
		"chokidar": "^4.0.3",
		"chokidar-cli": "^3.0.0",
		"clsx": "^2.1.1",
		"concurrently": "^9.1.2",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.27.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.9.0",
		"fast-check": "^4.1.1",
		"formsnap": "^2.0.1",
		"globals": "^16.2.0",
		"layerchart": "^2.0.0-next.10",
		"lucide-svelte": "^0.511.0",
		"mode-watcher": "^1.0.7",
		"paneforge": "^1.0.0-next.5",
		"pino-pretty": "^13.1.3",
		"postcss": "^8.5.3",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"prisma": "5.22.0",
		"pure-rand": "^7.0.1",
		"rimraf": "^6.0.1",
		"sass-embedded": "^1.89.0",
		"svelte": "^5.33.2",
		"svelte-check": "^4.2.1",
		"svelte-maplibre-gl": "^0.1.6",
		"svelte-sonner": "^1.0.3",
		"sveltekit-superforms": "2.27.1",
		"tailwind-merge": "^3.3.0",
		"tailwind-variants": "^0.2.1",
		"tailwindcss": "^4.1.7",
		"tailwindcss-animate": "^1.0.7",
		"tslib": "^2.8.1",
		"tsx": "^4.19.4",
		"tw-animate-css": "^1.3.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.32.1",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^6.3.5",
		"vitest": "^4.1.11",
		"zod": "^3.25.28"
	},
	"dependencies": {
		"@babel/runtime": "^7.27.6",
		"@contentful/rich-text-html-renderer": "^17.1.6",
		"@faker-js/faker": "^9.8.0",
		"@floating-ui/core": "^1.7.1",
		"@floating-ui/dom": "^1.7.1",
		"@floating-ui/utils": "^0.2.9",
		"@fontsource-variable/open-sans": "^5.2.5",
		"@fontsource-variable/raleway": "^5.2.5",
		"@fontsource/open-sans": "^5.2.5",
		"@lucia-auth/adapter-prisma": "^4.0.1",
		"@node-rs/argon2": "^2.0.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@oslojs/otp": "^1.1.0",
		"@pilcrowjs/object-parser": "^0.0.4",
		"@prisma/client": "5.22.0",
		"@sentry/sveltekit": "^10.74.0",
		"@stripe/stripe-js": "^7.9.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/adapter-vercel": "^5.7.2",
		"@swc/helpers": "^0.5.17",
		"@tailwindcss/vite": "^4.1.7",
		"@tinymce/tinymce-svelte": "^3.0.0",
		"@upstash/qstash": "^2.11.3",
		"@upstash/redis": "^1.38.4",
		"arctic": "^3.7.0",
		"argon2": "^0.43.0",
		"class-variance-authority": "^0.7.1",
		"cloudinary": "^2.6.1",
		"cmdk": "^1.1.1",
		"core-js": "^3.43.0",
		"css.escape": "^1.5.1",
		"date-fns": "^4.1.0",
		"devalue": "^5.1.1",
		"dompurify": "^3.2.6",
		"dotenv": "^16.5.0",
		"embla-carousel": "^8.6.0",
		"esm-env": "^1.2.2",
		"fflate": "^0.8.2",
		"gsap": "^3.13.0",
		"inline-style-parser": "^0.2.4",
		"input-otp": "^1.4.2",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.2",
		"lucia": "^3.2.2",
		"maplibre-gl": "^5.5.0",
		"memoize-weak": "^1.0.2",
		"mitt": "^3.0.1",
		"nanoid": "^5.1.5",
		"next-themes": "^0.4.6",
		"nodemailer": "^10.0.10",
		"performance-now": "^2.1.0",
		"pino": "^10.3.1",
		"prisma": "5.22.0",
		"raf": "^3.4.1",
		"runed": "^0.29.0",
		"sass": "^1.89.0",
		"smooth-scrollbar": "^8.8.4",
		"stripe": "^18.5.0",
		"style-to-object": "^1.0.9",
		"svelte-toolbelt": "^0.9.2",
		"tabbable": "^6.2.0",
		"tinymce": "^7.9.0",
		"uqr": "^0.1.2"
	},
	"overrides": {
		"@prisma/client": "5.22.0",
		"prisma": "5.22.0"
	}
}
