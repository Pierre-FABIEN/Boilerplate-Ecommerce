# Environnement des tests end-to-end.
# La base est la même instance Neon que le dev, mais dans un schéma PostgreSQL
# distinct (`e2e`) : les tests créent et suppriment des utilisateurs sans jamais
# toucher aux données de développement.
# Les guillemets sont indispensables : sans eux, `&` coupe la valeur dès qu'un
# shell source ce fichier.
DATABASE_URL="postgresql://sveltekitdb_owner:M8wWbtAf3ZjT@ep-yellow-night-a2swokm9-pooler.eu-central-1.aws.neon.tech/sveltekitdb?sslmode=require&channel_binding=require&schema=e2e"
DIRECT_URL="postgresql://sveltekitdb_owner:M8wWbtAf3ZjT@ep-yellow-night-a2swokm9.eu-central-1.aws.neon.tech/sveltekitdb?sslmode=require&schema=e2e"

ENCRYPTION_KEY=D9/JS6CJ98fnlGrcPR+N9w==
PUBLIC_ENV='test'
SECRET_NAME_DATA_COOKIE=test-cookie-name

# SMTP dirigé vers le puits local démarré par globalSetup : nodemailer réussit
# son envoi, aucun email ne part réellement, et les codes sont lus en base.
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_USER=e2e
SMTP_PASS=e2e

# Clés de test factices : aucun appel externe n'est attendu dans la suite auth.
VITE_GOOGLE_REDIRECT_URI=http://localhost:4173/auth/login/google/callback
GOOGLE_CLIENT_ID=e2e-google-client-id
GOOGLE_CLIENT_SECRET=e2e-google-client-secret

STRIPE_SECRET_KEY=sk_test_e2e
STRIPE_WEBHOOK_SECRET=whsec_e2e
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_e2e

SENDCLOUD_BASE_URL=https://panel.sendcloud.sc
SENDCLOUD_PUBLIC_KEY=e2e
SENDCLOUD_SECRET_KEY=e2e
SENDCLOUD_INTEGRATION_ID=0
VITE_SHOP_FROM_COUNTRY=FR
VITE_SHOP_FROM_POSTAL=31000

CLOUDINARY_CLOUD_NAME=e2e
CLOUDINARY_API_KEY=e2e
CLOUDINARY_API_SECRET=e2e
PUBLIC_TINYMCE_API_KEY=e2e
SECRET_CONTENTFUL_SPACE_ID=e2e
SECRET_CONTENTFUL_ACCESS_TOKEN=e2e
SECRET_OPENCAGEDATA_KEY=e2e
