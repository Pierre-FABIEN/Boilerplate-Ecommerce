# ---------------------------------------------------------------------------
# Base de données — PostgreSQL (Neon)
# ---------------------------------------------------------------------------
# DATABASE_URL : connexion via le pooler, utilisée par l'application au runtime.
#   postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# DIRECT_URL   : connexion directe (sans `-pooler`), requise par `prisma migrate`.
DATABASE_URL=****
DIRECT_URL=****

# ---------------------------------------------------------------------------
# Chiffrement & environnement
# ---------------------------------------------------------------------------
# ENCRYPTION_KEY : clé AES-128-GCM encodée en base64 (16 octets).
ENCRYPTION_KEY=****
PUBLIC_ENV='dev'
SECRET_NAME_DATA_COOKIE=****

# ---------------------------------------------------------------------------
# OAuth Google
# ---------------------------------------------------------------------------
VITE_GOOGLE_REDIRECT_URI=http://localhost:2000/auth/login/google/callback
GOOGLE_CLIENT_ID=****
GOOGLE_CLIENT_SECRET=****

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=****
# En local : secret affiché par `stripe listen` (npm run dev). En prod : secret
# du endpoint Dashboard, pas celui du CLI.
STRIPE_WEBHOOK_SECRET=****
VITE_STRIPE_PUBLISHABLE_KEY=****

# ---------------------------------------------------------------------------
# Sendcloud
# ---------------------------------------------------------------------------
SENDCLOUD_BASE_URL=https://panel.sendcloud.sc
SENDCLOUD_PUBLIC_KEY=****
SENDCLOUD_SECRET_KEY=****
SENDCLOUD_INTEGRATION_ID=****
SENDCLOUD_SENDER_ADDRESS_ID=****
# SENDCLOUD_DEBUG=true

# Adresse d'expédition par défaut, utilisée pour le calcul des frais de port.
VITE_SHOP_FROM_COUNTRY=FR
VITE_SHOP_FROM_POSTAL=31000

# ---------------------------------------------------------------------------
# Emails transactionnels (SMTP Brevo)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=****
SMTP_PASS=****

# ---------------------------------------------------------------------------
# Médias & CMS
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=****
CLOUDINARY_API_KEY=****
CLOUDINARY_API_SECRET=****
PUBLIC_TINYMCE_API_KEY=****
SECRET_CONTENTFUL_SPACE_ID=****
SECRET_CONTENTFUL_ACCESS_TOKEN=****

# ---------------------------------------------------------------------------
# Géocodage
# ---------------------------------------------------------------------------
SECRET_OPENCAGEDATA_KEY=****
